modules = ["java-graalvm22.3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GoDraw Application"

[[workflows.workflow]]
name = "GoDraw Application"
author = "agent"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd draw && mvn exec:java -Dexec.mainClass=\"com.gabriel.draw.Main\""

[[ports]]
localPort = 45961
externalPort = 80

[[ports]]
localPort = 46425
externalPort = 3000
